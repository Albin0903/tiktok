# ==============================================================================
# VeriteFiscale-2027 — Configuration d'environnement locale (Windows 11 ARM64)
# Copier ce fichier vers .env (ne jamais commiter .env)
# ==============================================================================

# --- Endpoints IA Locaux (llama-server.exe ARM64 CUDA) ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=NVIDIA-Nemotron-3.5-Lightning-30B-A3B
LOCAL_LLM_API_KEY=sk-local-none

LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
LOCAL_EMBEDDING_MODEL=embeddinggemma-2
LOCAL_EMBEDDING_API_KEY=sk-local-none

# --- Binaires locaux détectés sur RTX Spark Windows 11 ARM64 ---
LLAMA_SERVER_BINARY=C:/llama.cpp/llama-server.exe
FFMPEG_BINARY=C:/AI/jarvis/ffmpeg/ffmpeg-n8.1-latest-winarm64-gpl-shared-8.1/bin/ffmpeg.exe

# --- API Cloud optionnelle (extraction complémentaire / orchestration) ---
GEMINI_API_KEY=

# --- Sources Open Data officielles ---
INSEE_MELODI_API_URL=https://api.insee.fr/melodi
INSEE_MELODI_API_KEY=
ASSEMBLEE_OPENDATA_URL=https://data.assemblee-nationale.fr

# --- API FastAPI / Webapp ---
API_HOST=127.0.0.1
API_PORT=8000
OPENFISCA_REFERENCE_YEAR=2025
OPENFISCA_MAX_SPIRAL_LOOPS=3
